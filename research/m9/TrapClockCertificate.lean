/-- The 18-column local potential. Clipping the black values makes their uniform bound explicit. -/
def potential (w : List Bool) : Nat :=
  if w.headD false then min 10 (table (encList w)) else table (encList w)

def inequality (src dst : List Bool) : Bool :=
  decide (potential dst + (if dst.headD false then 17 else 0) ≤ potential src + 4)

private def localOK (code : Nat) : Bool :=
  [[false,false],[false,true],[true,false],[true,true]].all fun bits =>
    let w := decode code ++ bits
    allSucc (inequality w) w
