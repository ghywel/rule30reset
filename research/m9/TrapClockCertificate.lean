theorem local_step {s : List Bool} (hs : s ∈ trap) (a b x y : Bool) :
    inequality (s ++ [a,b]) (step2 (s ++ [a,b]) x y) = true := by
  obtain ⟨code, hc, rfl⟩ := List.mem_map.mp hs
  have c := List.all_eq_true.mp all_ok code hc
  unfold localOK at c
  have pair : [a,b] ∈ [[false,false],[false,true],[true,false],[true,true]] := by
    cases a <;> cases b <;> simp
  exact allSucc_spec (List.all_eq_true.mp c _ pair) x y

