private def predict (driver signature : Nat) := (outputBits.getD driver 0).testBit signature

private theorem cone_table : ∀ c0 c1 c2 c3 c4 c5 x01 x02 x03 x04 x05 x06 : Bool,
    let x11 := rule c0 x01 x02
    let x12 := rule x01 x02 x03
    let x13 := rule x02 x03 x04
    let x14 := rule x03 x04 x05
    let x15 := rule x04 x05 x06
    let x21 := rule c1 x11 x12
    let x22 := rule x11 x12 x13
    let x23 := rule x12 x13 x14
    let x24 := rule x13 x14 x15
    let x31 := rule c2 x21 x22
    let x32 := rule x21 x22 x23
    let x33 := rule x22 x23 x24
    let x41 := rule c3 x31 x32
    let x42 := rule x31 x32 x33
    let z0 := atSite c0 c1 x01 x02
    let z1 := atSite c1 c2 x11 x12
    let z2 := atSite c2 c3 x21 x22
    let z3 := atSite c3 c4 x31 x32
    let z4 := atSite c4 c5 x41 x42
    pack [c0, c1, c2, c3, c4, c5] ∉ exceptions →
    x41 = predict (pack [c0, c1, c2, c3, c4, c5]) (pack [x01, x11, x21, x31, z0, z1, z2, z3, z4]) := by
  set_option maxRecDepth 20000 in decide +kernel

def driverCode (t : Nat) := pack [center (t+0), center (t+1), center (t+2), center (t+3), center (t+4), center (t+5)]
private def signature (t : Nat) := pack [right (t+0), right (t+1), right (t+2), right (t+3), net (t+0), net (t+1), net (t+2), net (t+3), net (t+4)]

/-- Earliest tick is the low bit of the six-tick center word. -/
def permitted (t : Nat) := driverCode t ∉ exceptions

private theorem next_right (t : Nat) (allowed : permitted t) :
    right (t+4) = predict (driverCode t) (signature t) := by
  unfold signature
  simp only [net_atSite]
  exact cone_table (center (t+0)) (center (t+1)) (center (t+2)) (center (t+3)) (center (t+4)) (center (t+5))
    (cell t 1) (cell t 2) (cell t 3) (cell t 4) (cell t 5) (cell t 6) allowed

/-- Four right bits of memory suffice on these temporal center schedules. -/
theorem law : MemoryLaw 4 permitted net := by
  intro a b good cc zz rr
  have dc : driverCode a = driverCode b := by
    unfold driverCode
    rw [cc 0 (by decide), cc 1 (by decide), cc 2 (by decide), cc 3 (by decide), cc 4 (by decide), cc 5 (by decide)]
  have sc : signature a = signature b := by
    unfold signature
    rw [rr 0 (by decide), rr 1 (by decide), rr 2 (by decide), rr 3 (by decide), zz 0 (by decide), zz 1 (by decide), zz 2 (by decide), zz 3 (by decide), zz 4 (by decide)]
  have goodB : permitted b := by change driverCode b ∉ exceptions; rw [← dc]; exact good
  rw [next_right a good, next_right b goodB, dc, sc]

theorem net_aperiodic (hc : EventuallyPeriodic center)
    (ok : ∃ W, ∀ t, W≤t → permitted t) : ¬ EventuallyPeriodic net :=
  obs_aperiodic_of_memory law ok hc

theorem shell_aperiodic (hc : EventuallyPeriodic center)
    (ok : ∃ W, ∀ t, W≤t → permitted t) : ¬ EventuallyPeriodic shell := by
  intro hs
  obtain ⟨T,p,hp,pc,ps⟩ := common_period hc hs
  apply net_aperiodic hc ok
  refine ⟨T,p,hp,fun t ht => ?_⟩
  have eq : cell (t+p+2) 0 = cell (t+2) 0 := by
    rw [show t+p+2=t+2+p by omega]; exact pc (t+2) (by omega)
  rw [two_step (t+p),two_step t,ps t ht] at eq
  exact (by decide : ∀ a b c : Bool, xor a b=xor a c → b=c) _ _ _ eq

