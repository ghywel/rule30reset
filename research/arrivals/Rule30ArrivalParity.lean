module
public import Rule30ArrivalMemory

/-! A complete six-tick local reconstruction test for Troy Lowry's net
source parity. Words are listed in temporal order in the accompanying
read. In integer codes the earliest tick is bit zero. -/
@[expose] public section
namespace Ruliology.CellularAutomata.Rule30ArrivalParity
open Rule30Jen Rule30SourceArrivals Rule30ArrivalMemory

private def atSite (c n r u : Bool) : Bool :=
  xor (!c && xor r n) (xor (r && !u) (n && !rule c r u))

private theorem net_atSite (t : Nat) :
    net t = atSite (center t) (center (t+1)) (right t) (cell t 2) := by
  exact (by decide : ∀ l c r u : Bool, xor (l && !c)
    (xor (r && !u) (rule l c r && !rule c r u)) =
    atSite c (rule l c r) r u) _ _ _ _

def pack : List Bool → Nat
  | [] => 0
  | b::bs => b.toNat + 2 * pack bs

/-- The nine temporal center words on which the local channel can have two
different fifth right bits despite identical history and net observations. -/
def exceptions : List Nat := [8, 9, 10, 32, 33, 34, 40, 41, 42]

