module
public import WheelGateObserver
public import Ruliology.CellularAutomata.Rule30DrivenPrefix
public import Ruliology.CellularAutomata.Rule30SidewaysLocks

/-! Finite-window reduction for a physical 48-sample gate observation. -/
@[expose] public section
namespace Ruliology.CellularAutomata.WheelObserverTransport
open Rule30GateTrap Rule30GateTrapWords Rule30DrivenPrefix Rule30Ether Rule30StripCertificates
open Rule30PeriodTwoCoupled Rule30PeriodTwoSideways WheelGateObserver

abbrev sampleRow := Rule30DrivenPrefix.iterate
def nextRow (width w e : Nat) := double (w + e * 2^width) % 2^width

theorem nextRow_link (x t width : Nat) (_hw : 0 < width) :
    ∃ e, e<4 ∧ sampleRow x (t+1)%2^width = nextRow width (sampleRow x t%2^width) e := by
  let y := sampleRow x t
  let z := y % (2^width*4)
  let e := z / 2^width
  have pos := Nat.two_pow_pos width
  have mod_eq : z % 2^width = y % 2^width := Nat.mod_mod_of_dvd y ⟨4,rfl⟩
  have sum := Nat.mod_add_div z (2^width)
  rw [mod_eq,Nat.mul_comm] at sum
  have small : e < 4 := (Nat.div_lt_iff_lt_mul pos).2 (by
    simpa [z,Nat.mul_comm] using Nat.mod_lt y (by omega : 0<2^width*4))
  refine ⟨e,small,?_⟩
  change double y % 2^width = double (y%2^width + e*2^width) % 2^width
  rw [double_prefix y width,show 2^(width+2)=2^width*4 by simp [Nat.pow_add],sum]

def wordAt (w : Nat) (pat : List Bool) : Bool :=
  (List.range pat.length).all fun j => (sampleRow w j).testBit 0 == pat.getD j false

def admit (t w : Nat) : Bool :=
  !trapCodes.contains w && forbidden.all (fun pat => decide (48<t+pat.length) || !wordAt w pat)

def Cut : Prop := ∀ x : Nat, ¬∀ t, t<48 → admit t (sampleRow x t % 65536) = true

private theorem iterate_add (x t j : Nat) : iterate (iterate x t) j = iterate x (t+j) := by
  induction j with
  | zero => rfl
  | succ j ih => exact congrArg double ih

-- The finite-cone induction is the packed prefix argument of Rule30TrappedRuns.
private theorem cone (R : Nat → Bool) (b x W : Nat)
    (start : ∀ j, j < W → x.testBit j = drv altCol R b (j+1)) :
    ∀ t j, j+t < W →
      (packed (fun k => altCol (b+k)) x t).testBit j = drv altCol R (b+t) (j+1) := by
  intro t
  induction t with
  | zero => exact start
  | succ t ih =>
    intro j hj
    rw [packed,step_bit,show b+(t+1) = b+t+1 by omega, drv_isR30 altCol R (b+t) j]
    unfold Rule30Jen.rule
    rw [ih j (by omega), ih (j+1) (by omega)]
    cases j with
    | zero => simp [drv_col0]
    | succ j => simp [ih j (by omega)]

private theorem packed_twice (b x : Nat) (hb : b%2=1) :
    ∀ i, iterate x i = packed (fun k => altCol (b+k)) x (2*i) := by
  intro i
  induction i with
  | zero => rfl
  | succ i ih =>
    have ho : altCol (b+2*i) = false := by unfold altCol; simp; omega
    have he : altCol (b+(2*i+1)) = true := by unfold altCol; simp; omega
    rw [iterate,ih,show 2*(i+1)=2*i+1+1 by omega, packed,packed,ho,he,double]

private theorem prefix_bit : ∀ (n : Nat) (f : Nat → Bool) (j : Nat), j < n →
    (encList (seg f n)).testBit j = f j
  | 0, _, _, h => absurd h (by omega)
  | _+1, f, 0, _ => by
    rw [Nat.testBit_zero]
    simp only [seg, encList]
    cases f 0 <;> simp <;> omega
  | n+1, f, j+1, h => by
    rw [Nat.testBit_succ]
    change (((if f 0 then 1 else 0) + 2 * encList (seg (fun i => f (i+1)) n)) / 2).testBit j = _
    have e (a : Nat) : ((if f 0 then 1 else 0) + 2*a) / 2 = a := by cases f 0 <;> simp <;> omega
    rw [e]
    exact prefix_bit n _ j (by omega)


/-- The physical theorem has one closed, finite-state verification obligation. -/
theorem sound_of_cut (cut : Cut) : Sound 47 := by
  intro R s clean
  apply Classical.byContradiction
  intro last
  let b := 2*s+1
  let f := fun j => drv altCol R b (j+1)
  let x := encList (seg f 110)
  have agree (i j : Nat) (limit : j+2*i<110) :
      (iterate x i).testBit j = drv altCol R (2*(s+i)+1) (j+1) := by
    rw [packed_twice b x (by dsimp [b];omega),show 2*(s+i)+1=b+2*i by dsimp [b];omega]
    exact cone R b x 110 (prefix_bit 110 f) _ _ limit
  apply cut x
  intro t ht
  let w := iterate x t % 65536
  have out : w ∉ trapCodes := by
    intro inside
    have same : decode w = win R (2*(s+t)+1) := by
      unfold decode win rowOf
      apply Rule30SidewaysLocks.seg_congr
      intro j hj
      change ((iterate x t) % 2^16).testBit j = _
      rw [Nat.testBit_mod_two_pow]
      simpa [hj] using agree t j (by omega)
    have hit : win R (2*(s+t)+1) ∈ trap := List.mem_map.mpr ⟨w,inside,same⟩
    apply last
    have next := win_mem_trap R (t0:=2*(s+t)+1) (by omega) hit (47-t)
    simpa only [InTrap,show 2*(s+t)+1+2*(47-t)=2*(s+47)+1 by omega] using next
  change (!trapCodes.contains w && _) = true
  rw [Bool.and_eq_true]
  refine ⟨by simpa using out,List.all_eq_true.mpr ?_⟩
  intro pat mem
  by_cases fits : t+pat.length ≤ 48
  · have size : pat.length ≤ 7 := by
      have v : forbidden.all (fun l => decide (l.length≤7)) = true := by decide
      exact of_decide_eq_true (List.all_eq_true.mp v pat mem)
    have miss : wordAt w pat ≠ true := by
      intro found
      apply clean t pat mem fits
      intro j hj
      have bit := beq_iff_eq.mp (List.all_eq_true.mp found j (List.mem_range.mpr hj))
      change (iterate (iterate x t % 2^16) j).testBit 0 = _ at bit
      rw [iterate_mod_bit _ 16 j 0 (by omega),iterate_add] at bit
      rw [agree (t+j) 0 (by omega)] at bit
      simpa [Rule30PeriodTwoSideways.u,Nat.add_assoc] using bit
    simpa [show ¬48<t+pat.length by omega] using Bool.eq_false_iff.mpr miss
  · simp [show 48<t+pat.length by omega]



def maskOf : List Nat → Nat
  | [] => 0
  | n::ns => (1 <<< n) ||| maskOf ns

private theorem mem_of_mask {ns : List Nat} {u : Nat} (bit : (maskOf ns).testBit u = true) : u ∈ ns := by
  induction ns with
  | nil => simp [maskOf] at bit
  | cons n ns ih =>
    rw [maskOf,Nat.testBit_or,Bool.or_eq_true] at bit
    rcases bit with b|b
    · rw [Nat.testBit_shiftLeft] at b
      have h := Bool.and_eq_true_iff.mp b
      have le : n≤u := of_decide_eq_true h.1
      have z := Nat.testBit_one_eq_true_iff_self_eq_zero.mp h.2
      simp [show u=n by omega]
    · exact List.mem_cons_of_mem _ (ih b)

def trapMask : Nat := 
private theorem mask_checked : trapMask = maskOf trapCodes := by decide +kernel

def fullMask : Nat := 2^48-1

def patternMask (w : Nat) : List (List Bool) → Nat
  | [] => fullMask
  | p::ps => (if wordAt w p then fullMask <<< (49-p.length) else fullMask) &&& patternMask w ps

def baseMask (w : Nat) : Nat := if trapMask.testBit w then 0 else patternMask w forbidden

private theorem full_on {t : Nat} (h : t<48) : fullMask.testBit t = true := by
  rw [fullMask,Nat.testBit_two_pow_sub_one]
  exact decide_eq_true h

private theorem pattern_on {w t : Nat} (lt : t<48) (ps : List (List Bool))
    (h : ∀ p ∈ ps, t+p.length ≤ 48 → wordAt w p ≠ true) : (patternMask w ps).testBit t = true := by
  induction ps with
  | nil => exact full_on lt
  | cons p ps ih =>
    have rest := ih (fun q hq => h q (List.mem_cons_of_mem _ hq))
    simp only [patternMask,Nat.testBit_and,rest,Bool.and_true]
    by_cases starts : wordAt w p = true
    · have large : 48 < t+p.length := by
        exact Nat.lt_of_not_ge (fun small => h p (List.mem_cons_self ..) small starts)
      rw [if_pos starts,Nat.testBit_shiftLeft]
      simp only [show 49-p.length ≤ t by omega,decide_true,Bool.true_and]
      exact full_on (by omega)
    · simpa only [if_neg starts] using full_on lt

theorem baseMask_on {t w : Nat} (lt : t<48) (a : admit t w = true) :
    (baseMask w).testBit t = true := by
  simp only [admit,Bool.and_eq_true,Bool.not_eq_true'] at a
  have neg : trapMask.testBit w ≠ true := by
    intro bit
    rw [mask_checked] at bit
    have := mem_of_mask bit
    simpa [this] using a.1
  simp only [baseMask,neg,if_false]
  apply pattern_on lt
  intro p mem fits
  have ok := List.all_eq_true.mp a.2 p mem
  simpa [show ¬48<t+p.length by omega] using ok

def includesBits (small large : Nat) : Bool := (small ||| large) == large

def rowOK (W : Nat) (allowed F B : Nat → Nat) (u : Nat) : Bool :=
  includesBits (allowed u &&& 1) (F u) &&
  includesBits (F u &&& 2^47) (B u) &&
  ([0,1,2,3] : List Nat).all fun e =>
    let v := nextRow W u e
    includesBits ((F u <<< 1) &&& allowed v) (F v) &&
    includesBits ((B v >>> 1) &&& F u) (B u)

private theorem bit_of_includes {a b t : Nat} (h : includesBits a b = true)
    (bit : a.testBit t = true) : b.testBit t = true := by
  have eq := congrArg (fun k : Nat => k.testBit t) (beq_iff_eq.mp h)
  simpa [Nat.testBit_or,bit] using eq.symm

theorem layer_sound_path (x W : Nat) (hw : 0<W) (allowed F B : Nat → Nat)
    (rows : ∀ t, t<48 → rowOK W allowed F B (sampleRow x t%2^W) = true)
    (accepted : ∀ t, t<48 → (allowed (sampleRow x t%2^W)).testBit t = true) :
    ∀ t, t<48 → (B (sampleRow x t%2^W)).testBit t = true := by
  let w := fun t => sampleRow x t % 2^W
  have ok (t : Nat) (ht : t<48) := rows t ht
  have edge (t : Nat) (ht : t<47) :
      includesBits ((F (w t) <<< 1) &&& allowed (w (t+1))) (F (w (t+1))) = true ∧
      includesBits ((B (w (t+1)) >>> 1) &&& F (w t)) (B (w t)) = true := by
    obtain ⟨e,he,move⟩ := nextRow_link x t W hw
    have good := ok t (by omega)
    simp only [rowOK,Bool.and_eq_true] at good
    have mem : e ∈ [0,1,2,3] := List.mem_range.mpr he
    have both := List.all_eq_true.mp good.2 e mem
    simpa only [←move,w,Bool.and_eq_true] using both
  have fw (t : Nat) (ht : t<48) : (F (w t)).testBit t = true := by
    induction t with
    | zero =>
      have good := ok 0 (by decide)
      simp only [rowOK,Bool.and_eq_true] at good
      apply bit_of_includes good.1.1
      rw [Nat.testBit_and, show (allowed (w 0)).testBit 0 = true from accepted 0 (by decide)]
      decide
    | succ t ih =>
      apply bit_of_includes (edge t (by omega)).1
      simp [Nat.testBit_and,Nat.testBit_shiftLeft,ih (by omega),
        show (allowed (w (t+1))).testBit (t+1)=true from accepted _ ht]
  have bw (k : Nat) (hk : k≤47) : (B (w (47-k))).testBit (47-k) = true := by
    induction k with
    | zero =>
      have good := ok 47 (by decide)
      simp only [rowOK,Bool.and_eq_true] at good
      apply bit_of_includes good.1.2
      change (F (w 47) &&& 2^47).testBit 47=true
      rw [Nat.testBit_and,fw 47 (by decide)]
      decide
    | succ k ih =>
      let t := 47-(k+1)
      have eq : t+1=47-k := by dsimp [t]; omega
      apply bit_of_includes (edge t (by dsimp [t];omega)).2
      change ((B (w (t+1)) >>> 1) &&& F (w t)).testBit t=true
      rw [Nat.testBit_and,Nat.testBit_shiftRight,show 1+t=47-k by omega,eq,ih (by omega),fw t (by dsimp [t];omega)]
      rfl
  intro t ht
  simpa only [show 47-(47-t)=t by omega,w] using bw (47-t) (by omega)

theorem layer_sound (x W : Nat) (hw : 0<W) (allowed F B : Nat → Nat)
    (rows : ∀ u, u<2^W → allowed u ≠ 0 → rowOK W allowed F B u = true)
    (accepted : ∀ t, t<48 → (allowed (sampleRow x t%2^W)).testBit t = true) :
    ∀ t, t<48 → (B (sampleRow x t%2^W)).testBit t = true := by
  apply layer_sound_path x W hw allowed F B _ accepted
  intro t ht
  apply rows _ (Nat.mod_lt _ (Nat.two_pow_pos W))
  intro zero
  have v := accepted t ht
  simp [zero] at v

end Ruliology.CellularAutomata.WheelObserverTransport
