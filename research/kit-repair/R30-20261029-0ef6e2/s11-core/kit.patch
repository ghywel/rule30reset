+  induction rs generalizing l with
+  | nil => have := sound ok; grind
+  | cons r rs ih =>
+    simp only [cover,Bool.and_eq_true] at ok
+    by_cases h : s < r.stop
+    · exact chain_sound ⟨hl,h⟩ _ _ ok.1 (by grind)
+    · exact ih _ (by grind) ok.2
