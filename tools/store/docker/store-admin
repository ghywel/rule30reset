#!/usr/bin/env php
<?php
/*
 * store-admin: manage the store's worker tokens from a shell inside the container. Never reachable from the web.
 *   store-admin token add NAME            make a token: stores its SHA-256, prints the token once
 *   store-admin token import NAME SHA256  keep an existing token: store the SHA-256 you already have
 *   store-admin token remove NAME         revoke
 *   store-admin token list                the names
 *   store-admin check                     the settings in force (no secrets) and whether the folders are writable
 *   store-admin verify                    exit 0 if the registry is absent or valid, 1 with the reason if it is damaged
 *   store-admin health                    exit 0 if the store answers inside the container (the image's health check)
 *
 * Every change is made under an exclusive lock, from the registry as it stands at that moment, and is reported only
 * after the new registry is on disk and has been read back. A change that cannot be saved leaves the old registry
 * in place and exits 1. A registry that exists but cannot be read or is not valid is never replaced.
 */
if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}
require_once (is_file('/app/registry.php') ? '/app' : __DIR__) . '/registry.php';

$file = getenv('STORE_WORKERS_FILE') ?: '/config/workers.json';

function stop(string $message): never
{
    fwrite(STDERR, "store-admin: $message\n");
    exit(1);
}

function worker_name(?string $n): string
{
    if ($n === null || !preg_match(REGISTRY_NAME, $n)) {
        stop('a worker name is 1 to 32 letters, digits or hyphens');
    }
    return $n;
}

/* The registry for reading: a damaged one stops the command. */
function registry_now(string $file): array
{
    [$state, $workers, $why] = registry_read($file);
    if ($state === 'bad') {
        stop("the registry $file is damaged ($why). Nothing was changed. Repair or restore it by hand; "
            . 'only a registry that does not exist is started afresh.');
    }
    return $workers;
}

/* Run $change on the registry under an exclusive lock and save what it returns. Returns only after the new registry
   is on disk and reads back as intended; otherwise the old one is still in place and the command has stopped. */
function change(string $file, callable $change): void
{
    umask(0177);                                   // the lock, the temporary file and the registry: owner only
    $lock = @fopen($file . '.lock', 'c');
    if ($lock === false || !flock($lock, LOCK_EX)) {
        stop("cannot lock the registry (is the folder of $file writable by this user?). Nothing was changed.");
    }
    $workers = $change(registry_now($file));
    [$state, , $why] = registry_parse(registry_text($workers));
    if ($state !== 'ok') {
        stop("refusing to write a registry that is not valid ($why). Nothing was changed.");
    }
    $text = registry_text($workers);
    $tmp = $file . '.tmp-' . bin2hex(random_bytes(8));
    $out = @fopen($tmp, 'xb');                     // created new, mode 0600 from the start
    $ok = $out !== false
        && @fwrite($out, $text) === strlen($text)
        && @fflush($out)
        && @fsync($out);
    if ($out !== false) {
        $ok = @fclose($out) && $ok;
    }
    $ok = $ok && @file_get_contents($tmp) === $text && @rename($tmp, $file);
    if (!$ok) {
        @unlink($tmp);
        stop("could not save the registry beside $file (folder not writable, or no space). Nothing was changed.");
    }
    [$state, $saved] = registry_read($file);
    if ($state !== 'ok' || $saved != $workers) {
        stop("the registry $file does not read back as written. Check it before relying on any token.");
    }
    flock($lock, LOCK_UN);
}

$a = array_slice($argv, 1);
$cmd = implode(' ', array_slice($a, 0, 2));
if ($cmd === 'token add') {
    $n = worker_name($a[2] ?? null);
    $token = bin2hex(random_bytes(32));
    change($file, static function (array $w) use ($n, $token): array {
        if (isset($w[$n])) {
            stop("'$n' already has a token; remove it first to replace it. Nothing was changed.");
        }
        $w[$n] = hash('sha256', $token);
        return $w;
    });
    echo "Token for '$n' (shown once; give it to that worker through its own secret settings, never by chat):\n$token\n";
} elseif ($cmd === 'token import') {
    $n = worker_name($a[2] ?? null);
    $h = strtolower($a[3] ?? '');
    if (!preg_match(REGISTRY_HASH, $h)) {
        stop("give the token's SHA-256, 64 hex digits (not the token itself)");
    }
    change($file, static function (array $w) use ($n, $h): array {
        if (isset($w[$n])) {
            stop($w[$n] === $h ? "'$n' already holds that token. Nothing was changed."
                : "'$n' already has a token; remove it first to replace it. Nothing was changed.");
        }
        $holder = array_search($h, $w, true);
        if ($holder !== false) {
            stop("that token already belongs to '$holder': one token cannot name two workers. Nothing was changed.");
        }
        $w[$n] = $h;
        return $w;
    });
    echo "'$n' imported.\n";
} elseif ($cmd === 'token remove') {
    $n = worker_name($a[2] ?? null);
    change($file, static function (array $w) use ($n): array {
        if (!isset($w[$n])) {
            stop("no worker '$n'. Nothing was changed.");
        }
        unset($w[$n]);
        return $w;
    });
    echo "'$n' removed.\n";
} elseif ($cmd === 'token list') {
    foreach (array_keys(registry_now($file)) as $n) {
        echo "$n\n";
    }
} elseif (($a[0] ?? '') === 'verify') {
    registry_now($file);
    echo "ok\n";
} elseif (($a[0] ?? '') === 'check') {
    $cfg = require (getenv('SHAREDSTORE_CONFIG') ?: '/app/config.php');
    $cfg['workers'] = array_keys($cfg['workers']);
    $cfg['tls'] = getenv('STORE_TLS') ?: '';
    $cfg['domain'] = getenv('STORE_DOMAIN') ?: '';
    $cfg['data_dir_writable'] = is_writable($cfg['data_dir']);
    $cfg['config_dir_writable'] = is_writable(dirname($file));
    $cfg['running_as'] = posix_getuid() . ':' . posix_getgid();
    echo json_encode($cfg, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
} elseif (($a[0] ?? '') === 'health') {
    // Without a token the store answers 401, or 403 where it insists on HTTPS: either shows PHP and the settings work.
    $port = getenv('STORE_HEALTH_PORT') ?: '8081';
    $ctx = stream_context_create(['http' => ['timeout' => 5, 'ignore_errors' => true]]);
    $body = @file_get_contents("http://127.0.0.1:$port/store.php?whoami", false, $ctx);
    $head = function_exists('http_get_last_response_headers') ? (http_get_last_response_headers() ?? []) : [];
    $ok = $body !== false && preg_match('/^HTTP\/\S+ 40[13]\b/', $head[0] ?? '') && is_array(json_decode($body, true));
    if (!$ok) {
        stop('the store did not answer as expected: ' . ($head[0] ?? 'no reply'));
    }
    echo "ok\n";
} else {
    stop('usage: store-admin token add|import|remove|list ... | store-admin check | verify | health');
}
